#!/usr/bin/env bash
# ==============================================================================
# ntfs-tool — Modern Kext-less NTFS Read/Write Utility for macOS
# Compatible with macOS 13 (Ventura), 14 (Sonoma), 15 (Sequoia), 26 (Tahoe)+
# Built for Apple Silicon (M1/M2/M3/M4) & Intel Macs using FUSE-T and NTFS-3G
# Author: Atila Sevindi (https://github.com/atilasevindi)
# ==============================================================================

set -o pipefail

VERSION="1.0.0"
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)/$(basename "${BASH_SOURCE[0]}")"

# Terminal ANSI Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m' # No Color

# Detect Homebrew and binary locations
if [[ -x "/opt/homebrew/bin/brew" ]]; then
    BREW_BIN="/opt/homebrew/bin/brew"
    HOMEBREW_PREFIX="/opt/homebrew"
elif [[ -x "/usr/local/bin/brew" ]]; then
    BREW_BIN="/usr/local/bin/brew"
    HOMEBREW_PREFIX="/usr/local"
else
    BREW_BIN="$(command -v brew 2>/dev/null || true)"
    HOMEBREW_PREFIX="/opt/homebrew"
fi

NTFS3G_BIN="${HOMEBREW_PREFIX}/bin/ntfs-3g"
if [[ ! -x "$NTFS3G_BIN" ]]; then
    NTFS3G_BIN="$(command -v ntfs-3g 2>/dev/null || true)"
fi

log_info()    { echo -e "${CYAN}ℹ${NC} $1"; }
log_success() { echo -e "${GREEN}✔${NC} $1"; }
log_warning() { echo -e "${YELLOW}⚠${NC} $1"; }
log_error()   { echo -e "${RED}✖${NC} $1"; }

# Send macOS desktop notification
notify() {
    local title="$1"
    local message="$2"
    if command -v osascript &>/dev/null; then
        osascript -e "display notification \"$message\" with title \"$title\" sound name \"default\"" 2>/dev/null || true
    fi
}

# ------------------------------------------------------------------------------
# 1. Dependency and Environment Healthcheck (Doctor)
# ------------------------------------------------------------------------------
check_dependencies() {
    echo -e "\n${BOLD}=== Environment & Dependency Healthcheck ===${NC}"
    local all_good=true

    # macOS System Version & Kernel
    local os_ver os_build arch
    os_ver="$(sw_vers -productVersion 2>/dev/null || echo "Unknown")"
    os_build="$(sw_vers -buildVersion 2>/dev/null || echo "Unknown")"
    arch="$(uname -m)"
    log_info "macOS Version: ${BOLD}$os_ver ($os_build)${NC}"
    log_info "Architecture:  ${BOLD}$arch${NC}"

    # Check Homebrew
    if [[ -x "$BREW_BIN" ]]; then
        log_success "Homebrew installed: $BREW_BIN"
    else
        log_error "Homebrew not found! (Install from https://brew.sh)"
        all_good=false
    fi

    # Check FUSE-T (Kext-less FUSE engine)
    if [[ -d "/Library/Application Support/fuse-t" ]] || \
       [[ -f "/usr/local/lib/libfuse-t.dylib" ]] || \
       [[ -f "${HOMEBREW_PREFIX}/lib/libfuse-t.dylib" ]] || \
       { [[ -n "$BREW_BIN" ]] && "$BREW_BIN" list --cask fuse-t >/dev/null 2>&1; }; then
        log_success "FUSE-T (Kext-less FUSE implementation) is installed."
    elif [[ -d "/Library/Filesystems/macfuse.fs" ]]; then
        log_warning "macFUSE detected (Requires Kernel Extension authorization in Recovery Mode on Apple Silicon)."
    else
        log_error "FUSE-T is not installed!"
        all_good=false
    fi

    # Check NTFS-3G binary
    if [[ -x "$NTFS3G_BIN" ]]; then
        log_success "NTFS-3G binary found: $NTFS3G_BIN"
    else
        log_error "NTFS-3G binary not found!"
        all_good=false
    fi

    echo ""
    if $all_good; then
        log_success "${BOLD}System ready! You have all requirements to mount NTFS in Read/Write mode.${NC}"
        return 0
    else
        log_warning "To automatically resolve missing packages, run:"
        echo -e "  ${BOLD}$SCRIPT_PATH install-deps${NC}\n"
        return 1
    fi
}

# ------------------------------------------------------------------------------
# 2. Automated Dependency Installer
# ------------------------------------------------------------------------------
install_dependencies() {
    echo -e "\n${BOLD}=== Installing Required Dependencies (FUSE-T & NTFS-3G) ===${NC}"

    if [[ ! -x "$BREW_BIN" ]]; then
        log_error "Homebrew is required. Install it using:"
        echo '  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
        exit 1
    fi

    log_info "Tapping required Homebrew repositories..."
    "$BREW_BIN" tap macos-fuse-t/homebrew-cask 2>/dev/null || true
    "$BREW_BIN" tap gromgit/fuse 2>/dev/null || true

    log_info "Installing FUSE-T (User-space Kext-less FUSE engine)..."
    "$BREW_BIN" install --cask fuse-t || true

    log_info "Installing NTFS-3G compiled for macOS..."
    "$BREW_BIN" install gromgit/fuse/ntfs-3g-mac || "$BREW_BIN" install ntfs-3g || true

    # Re-evaluate binary path
    NTFS3G_BIN="${HOMEBREW_PREFIX}/bin/ntfs-3g"
    if [[ ! -x "$NTFS3G_BIN" ]]; then
        NTFS3G_BIN="$(command -v ntfs-3g 2>/dev/null || true)"
    fi

    if [[ -x "$NTFS3G_BIN" ]]; then
        log_success "NTFS-3G installed and verified: $NTFS3G_BIN"
    else
        log_error "Failed to verify NTFS-3G binary. Try running manually: brew install gromgit/fuse/ntfs-3g-mac"
        exit 1
    fi

    log_success "Installation completed successfully!"
}

# ------------------------------------------------------------------------------
# 3. List Connected NTFS Disks
# ------------------------------------------------------------------------------
list_ntfs_disks() {
    echo -e "\n${BOLD}=== Connected NTFS Drives & Mount Status ===${NC}"

    local found_any=false
    local ntfs_mounts
    ntfs_mounts="$(mount | grep -iE '(\(ntfs|type ntfs)' || true)"

    if [[ -n "$ntfs_mounts" ]]; then
        while IFS= read -r line; do
            found_any=true
            local dev mnt opts mode vol_name
            dev="$(echo "$line" | awk '{print $1}')"
            mnt="$(echo "$line" | sed -E 's/.* on (.*) \((.*)\)/\1/')"
            opts="$(echo "$line" | sed -E 's/.* \((.*)\)/\1/')"

            if [[ "$opts" =~ read-only ]]; then
                mode="${YELLOW}Read-Only (Default macOS FSKit Driver)${NC}"
            else
                mode="${GREEN}Read-Write (NTFS-3G Active)${NC}"
            fi

            vol_name="$(basename "$mnt")"

            echo -e "  ${BOLD}Device Node:${NC}  $dev"
            echo -e "  ${BOLD}Volume Name:${NC}  $vol_name"
            echo -e "  ${BOLD}Mount Point:${NC}  $mnt"
            echo -e "  ${BOLD}Access Mode:${NC}  $mode"
            echo -e "  ${BOLD}Mount Flags:${NC}  ${DIM}$opts${NC}"
            echo -e "  ----------------------------------------------------"
        done <<< "$ntfs_mounts"
    fi

    # Check unmounted NTFS partitions via diskutil if available
    if command -v diskutil &>/dev/null; then
        local unmounted_ntfs
        unmounted_ntfs="$(diskutil list 2>/dev/null | grep -iE '(Windows_NTFS|Microsoft Basic Data)' | awk '{print $NF}' || true)"
        if [[ -n "$unmounted_ntfs" ]]; then
            for part in $unmounted_ntfs; do
                local dev_node="/dev/$part"
                if ! echo "$ntfs_mounts" | grep -q "$dev_node"; then
                    found_any=true
                    local info_name
                    info_name="$(diskutil info "$dev_node" 2>/dev/null | grep "Volume Name:" | awk -F':' '{print $2}' | xargs || echo "Untitled")"
                    echo -e "  ${BOLD}Device Node:${NC}  $dev_node"
                    echo -e "  ${BOLD}Volume Name:${NC}  $info_name"
                    echo -e "  ${BOLD}Status:${NC}       ${RED}Unmounted${NC}"
                    echo -e "  ----------------------------------------------------"
                fi
            done
        fi
    fi

    if ! $found_any; then
        log_warning "No connected NTFS drives detected."
        echo "  (Please plug in your USB NTFS external drive and try again.)"
    fi
    echo ""
}

# ------------------------------------------------------------------------------
# 4. Mount NTFS Drive in Read/Write Mode
# ------------------------------------------------------------------------------
mount_rw() {
    local target_dev="$1"

    # Auto-detect device if not explicitly provided
    if [[ -z "$target_dev" ]]; then
        local first_ntfs
        first_ntfs="$(mount | grep -iE '(\(ntfs|type ntfs)' | head -n 1 | awk '{print $1}')"
        if [[ -n "$first_ntfs" ]]; then
            target_dev="$first_ntfs"
            log_info "Auto-detected active NTFS device: ${BOLD}$target_dev${NC}"
        else
            log_error "No target device provided and no connected NTFS disk found!"
            echo "Usage: sudo $SCRIPT_PATH mount /dev/diskXsY"
            exit 1
        fi
    fi

    # Root privilege check
    if [[ $EUID -ne 0 ]]; then
        log_error "Root privileges required to mount filesystem. Please run with sudo:"
        echo "  sudo $SCRIPT_PATH mount $target_dev"
        exit 1
    fi

    if [[ ! -x "$NTFS3G_BIN" ]]; then
        log_error "ntfs-3g binary not found. Please run: $SCRIPT_PATH install-deps"
        exit 1
    fi

    log_info "Analyzing target device: $target_dev"

    # Detect current mount point and volume name
    local current_mount
    current_mount="$(mount | grep "^$target_dev on " | sed -E 's/.* on (.*) \((.*)\)/\1/' || true)"

    local vol_name="NTFS_DRIVE"
    if [[ -n "$current_mount" ]]; then
        vol_name="$(basename "$current_mount")"
        log_info "Current read-only mount point: $current_mount"
        log_info "Unmounting native macOS (FSKit) read-only volume..."

        diskutil unmount "$target_dev" 2>/dev/null || umount "$current_mount" 2>/dev/null || diskutil unmount force "$target_dev" 2>/dev/null || true
        sleep 1
    else
        if command -v diskutil &>/dev/null; then
            local probed_name
            probed_name="$(diskutil info "$target_dev" 2>/dev/null | grep "Volume Name:" | awk -F':' '{print $2}' | xargs || true)"
            if [[ -n "$probed_name" && "$probed_name" != "Not applicable" ]]; then
                vol_name="$probed_name"
            fi
        fi
    fi

    # Prepare mount directory
    local target_mount="/Volumes/$vol_name"
    if [[ -d "$target_mount" && "$(ls -A "$target_mount" 2>/dev/null)" ]]; then
        target_mount="/Volumes/${vol_name}_RW"
    fi
    mkdir -p "$target_mount"

    log_info "Mounting with NTFS-3G (Read/Write) -> $target_mount"

    # Mount using production-ready ntfs-3g options
    if "$NTFS3G_BIN" "$target_dev" "$target_mount" \
        -o "local,allow_other,auto_xattr,volname=$vol_name,windows_names" 2>/tmp/ntfs3g_err.log; then

        # Verify write capability
        local test_file="$target_mount/.ntfs_write_test_$$"
        if touch "$test_file" 2>/dev/null; then
            rm -f "$test_file"
            log_success "${BOLD}$vol_name ($target_dev) successfully mounted in READ/WRITE mode!${NC}"
            echo -e "  ${BOLD}Location:${NC} $target_mount"
            notify "NTFS Tool" "$vol_name mounted in full Read/Write mode."

            # Reveal in Finder
            if [[ -n "$SUDO_USER" ]]; then
                sudo -u "$SUDO_USER" open "$target_mount" 2>/dev/null || true
            else
                open "$target_mount" 2>/dev/null || true
            fi
            return 0
        else
            log_warning "Volume mounted, but write test failed. Please check permissions."
        fi
    else
        log_error "NTFS-3G mount failed!"
        [[ -f /tmp/ntfs3g_err.log ]] && cat /tmp/ntfs3g_err.log
        rmdir "$target_mount" 2>/dev/null || true
        exit 1
    fi
}

# ------------------------------------------------------------------------------
# 5. Safe Unmount and Eject
# ------------------------------------------------------------------------------
unmount_drive() {
    local target="$1"

    if [[ -z "$target" ]]; then
        target="$(mount | grep -iE '(\(ntfs|type ntfs)' | head -n 1 | awk '{print $1}')"
        if [[ -z "$target" ]]; then
            log_error "No active NTFS drive specified or found."
            exit 1
        fi
    fi

    log_info "Flushing cached filesystem buffers (sync)..."
    sync

    if [[ -d "$target" ]]; then
        log_info "Unmounting mount point: $target"
        umount "$target" 2>/dev/null || diskutil unmount "$target" 2>/dev/null || true
        rmdir "$target" 2>/dev/null || true
        log_success "Volume cleanly unmounted."
        notify "NTFS Tool" "Drive unmounted safely."
        return 0
    fi

    log_info "Unmounting device: $target"
    diskutil unmount "$target" 2>/dev/null || umount "$target" 2>/dev/null || true

    # Eject parent physical disk safely
    local parent_disk
    parent_disk="$(echo "$target" | sed -E 's/(disk[0-9]+)s[0-9]+/\1/')"
    if [[ -n "$parent_disk" ]]; then
        log_info "Ejecting physical disk ($parent_disk)..."
        diskutil eject "$parent_disk" 2>/dev/null || true
    fi

    log_success "Drive safely unmounted and detached."
    notify "NTFS Tool" "Drive detached safely."
}

# ------------------------------------------------------------------------------
# 6. Automated USB Watcher Daemon
# ------------------------------------------------------------------------------
run_watcher() {
    log_info "${BOLD}NTFS Auto-Mount Watcher started...${NC}"
    log_info "Any newly plugged NTFS USB drive will be automatically remounted in Read/Write mode."
    log_info "Press Ctrl+C to stop."

    if [[ $EUID -ne 0 ]]; then
        log_error "Watcher daemon requires root privileges ('sudo')."
        exit 1
    fi

    while true; do
        local ro_disks
        ro_disks="$(mount | grep -iE '(\(ntfs|type ntfs)' | grep -i 'read-only' | awk '{print $1}' || true)"

        if [[ -n "$ro_disks" ]]; then
            for disk in $ro_disks; do
                log_info "Detected read-only NTFS volume on $disk. Converting to Read/Write..."
                mount_rw "$disk" || true
            done
        fi
        sleep 3
    done
}

# ------------------------------------------------------------------------------
# 7. Launchd System Service Setup
# ------------------------------------------------------------------------------
install_daemon() {
    local plist_path="/Library/LaunchDaemons/com.github.ntfs-tool.automount.plist"

    if [[ $EUID -ne 0 ]]; then
        log_error "Root privileges required to install launchd service: sudo $SCRIPT_PATH install-daemon"
        exit 1
    fi

    local installed_binary
    installed_binary="$(command -v ntfs-tool || echo "$SCRIPT_PATH")"

    log_info "Generating LaunchDaemon at $plist_path..."
    cat <<EOF > "$plist_path"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.github.ntfs-tool.automount</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$installed_binary</string>
        <string>watch</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/ntfs_automount.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/ntfs_automount_err.log</string>
</dict>
</plist>
EOF

    chmod 644 "$plist_path"
    chown root:wheel "$plist_path"
    launchctl unload "$plist_path" 2>/dev/null || true
    launchctl load "$plist_path"

    log_success "LaunchDaemon service installed and started!"
    log_info "Log files: /var/log/ntfs_automount.log"
}

uninstall_daemon() {
    local plist_path="/Library/LaunchDaemons/com.github.ntfs-tool.automount.plist"
    if [[ $EUID -ne 0 ]]; then
        log_error "Root privileges required: sudo $SCRIPT_PATH uninstall-daemon"
        exit 1
    fi
    launchctl unload "$plist_path" 2>/dev/null || true
    rm -f "$plist_path"
    log_success "LaunchDaemon service removed."
}

# ------------------------------------------------------------------------------
# 8. Interactive TUI Menu
# ------------------------------------------------------------------------------
show_menu() {
    clear
    echo -e "${BOLD}${CYAN}====================================================${NC}"
    echo -e "${BOLD}${CYAN}   ntfs-tool — macOS NTFS Read/Write Manager        ${NC}"
    echo -e "${BOLD}${CYAN}   v$VERSION | Apple Silicon & Intel (FUSE-T Engine) ${NC}"
    echo -e "${BOLD}${CYAN}====================================================${NC}"
    echo ""
    echo -e "  ${BOLD}1)${NC} List Connected NTFS Drives"
    echo -e "  ${BOLD}2)${NC} Mount Drive in Read/Write Mode"
    echo -e "  ${BOLD}3)${NC} Safely Unmount / Eject Drive"
    echo -e "  ${BOLD}4)${NC} Run Dependency Doctor (Check FUSE-T & NTFS-3G)"
    echo -e "  ${BOLD}5)${NC} Install Missing Dependencies"
    echo -e "  ${BOLD}6)${NC} Start Auto-Mount Watcher (Terminal Loop)"
    echo -e "  ${BOLD}7)${NC} Install Background LaunchDaemon Service"
    echo -e "  ${BOLD}8)${NC} Uninstall Background LaunchDaemon Service"
    echo -e "  ${BOLD}0)${NC} Exit"
    echo ""
    read -rp "Please enter your choice [0-8]: " choice

    case "$choice" in
        1) list_ntfs_disks ;;
        2)
            list_ntfs_disks
            read -rp "Enter device node (e.g. /dev/disk6s2 or press Enter for auto): " dev
            mount_rw "$dev"
            ;;
        3)
            list_ntfs_disks
            read -rp "Enter device node or mount point to unmount: " dev
            unmount_drive "$dev"
            ;;
        4) check_dependencies ;;
        5) install_dependencies ;;
        6) run_watcher ;;
        7) install_daemon ;;
        8) uninstall_daemon ;;
        0) exit 0 ;;
        *) log_error "Invalid selection!" ;;
    esac
}

# ------------------------------------------------------------------------------
# CLI Router
# ------------------------------------------------------------------------------
case "$1" in
    list|ls|status)
        list_ntfs_disks
        ;;
    mount|mount-rw|rw)
        shift
        mount_rw "$1"
        ;;
    unmount|umount|eject)
        shift
        unmount_drive "$1"
        ;;
    doctor|check)
        check_dependencies
        ;;
    install-deps|setup)
        install_dependencies
        ;;
    watch|daemon)
        run_watcher
        ;;
    install-daemon)
        install_daemon
        ;;
    uninstall-daemon)
        uninstall_daemon
        ;;
    version|-v|--version)
        echo "ntfs-tool v$VERSION"
        ;;
    help|--help|-h)
        echo "ntfs-tool — Modern Kext-less NTFS Read/Write Utility for macOS"
        echo ""
        echo "Usage: sudo ntfs-tool [command] [arguments]"
        echo ""
        echo "Commands:"
        echo "  list               List all connected NTFS volumes and mount status"
        echo "  mount [device]     Remount target NTFS volume in Read/Write mode"
        echo "  unmount [device]   Safely sync, unmount, and detach the NTFS volume"
        echo "  doctor             Run system checks for Homebrew, FUSE-T, and NTFS-3G"
        echo "  install-deps       Automatically install FUSE-T and NTFS-3G via Homebrew"
        echo "  watch              Run live foreground watcher to auto-mount connected NTFS drives"
        echo "  install-daemon     Register and start background macOS LaunchDaemon service"
        echo "  uninstall-daemon   Stop and remove background LaunchDaemon service"
        echo "  version            Display version information"
        echo "  help               Show this help message"
        ;;
    *)
        if [[ -n "$1" ]]; then
            log_error "Unknown command: $1"
            echo "Run 'ntfs-tool help' for usage guidelines."
            exit 1
        else
            show_menu
        fi
        ;;
esac
